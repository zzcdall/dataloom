# Where uploaded datasets and metadata are stored.
DATALOOM_DATA_DIR=./data

# Maximum upload size in megabytes.
DATALOOM_MAX_UPLOAD_MB=100

# Optional: OpenAI-compatible model used only for planning and wording.
# Leave empty to use the deterministic local planner.
DATALOOM_LLM_BASE_URL=
DATALOOM_LLM_API_KEY=
DATALOOM_LLM_MODEL=

